import java.util.*;

public class Shortest_Path_DAG {

    static class Pair {
        int v;
        int wt;

        Pair(int v, int wt) {
            this.v = v;
            this.wt = wt;
        }
    }

    static void topoSort(int node,
                         boolean[] vis,
                         Stack<Integer> st,
                         ArrayList<ArrayList<Pair>> adj) {

        vis[node] = true;

        for (Pair nbr : adj.get(node)) {

            if (!vis[nbr.v]) {
                topoSort(nbr.v, vis, st, adj);
            }
        }

        st.push(node);
    }

    static int[] shortestPath(int N,
                              int M,
                              int[][] edges) {

        ArrayList<ArrayList<Pair>> adj = new ArrayList<>();

        for (int i = 0; i < N; i++) {
            adj.add(new ArrayList<>());
        }

        for (int[] e : edges) {

            int u = e[0];
            int v = e[1];
            int wt = e[2];

            adj.get(u).add(new Pair(v, wt));
        }

        boolean[] vis = new boolean[N];
        Stack<Integer> st = new Stack<>();

        for (int i = 0; i < N; i++) {

            if (!vis[i]) {
                topoSort(i, vis, st, adj);
            }
        }

        int[] dist = new int[N];

        Arrays.fill(dist, (int)1e9);

        dist[0] = 0;

        while (!st.isEmpty()) {

            int node = st.pop();

            if (dist[node] != (int)1e9) {

                for (Pair nbr : adj.get(node)) {

                    int v = nbr.v;
                    int wt = nbr.wt;

                    if (dist[node] + wt < dist[v]) {

                        dist[v] = dist[node] + wt;
                    }
                }
            }
        }

        for (int i = 0; i < N; i++) {

            if (dist[i] == (int)1e9) {
                dist[i] = -1;
            }
        }

        return dist;
    }

